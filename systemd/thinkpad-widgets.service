[Unit]
Description=Widgets de sistema no fundo da tela
PartOf=graphical-session.target
After=graphical-session.target
# Reinicia sem limite: o compositor pode reiniciar e a tela pode mudar.
StartLimitIntervalSec=0

[Service]
Environment=PYTHONPATH=%h/.local/share/thinkpad-widgets
ExecStart=/usr/bin/python3 -m thinkpad_widgets
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
